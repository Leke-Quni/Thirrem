# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# --- Home-hosted backend (docker-compose.demo.yml, `yarn demo:up`) ---
POSTGRES_PASSWORD=change-me
# Comma-separated browser origins allowed to call the API. `*` matches one
# subdomain label, so preview deploys work: https://thirrem-rider-*.vercel.app
CORS_ORIGINS=https://thirrem-rider.vercel.app,https://thirrem-rider-*.vercel.app,https://thirrem-driver.vercel.app,https://thirrem-driver-*.vercel.app

# --- Card payments (API, local and demo). Test mode keys only: the API refuses live ones. ---
# From https://dashboard.stripe.com/test/apikeys. Leave empty to run without card payments.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- API (local development only; defaults match `yarn db:up`) ---
# DATABASE_URL=postgres://thirrem:thirrem@localhost:5433/thirrem
# PORT=5001

# --- Rider and Driver apps, set in each Vercel project (production and preview) ---
# API_BASE_URL=https://<your-machine>.<tailnet>.ts.net
