{
  "name": "thirrem",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "test:api": "yarn workspace @thirrem/api test",
    "test:e2e": "playwright test",
    "build": "yarn workspace @thirrem/api build",
    "dev": "yarn db:up && concurrently --names api,rider --prefix-colors magenta,cyan --kill-others-on-fail \"yarn dev:api\" \"yarn dev:rider\"",
    "stop": "bash scripts/stop.sh",
    "dev:api": "yarn build && yarn workspace @thirrem/api migrate && yarn workspace @thirrem/api start",
    "dev:rider": "yarn workspace @thirrem/rider dev",
    "demo:up": "bash scripts/demo-up.sh",
    "demo:down": "bash scripts/demo-down.sh",
    "test:rider": "yarn workspace @thirrem/rider test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9",
    "typescript": "^6.0.3"
  }
}
